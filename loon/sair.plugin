#!name = SAIR - Siri-ously AI Router
#!desc = Route Mainland China Apple Intelligence requests to an OpenAI-compatible provider through Loon.
#!author = boitar
#!homepage = https://github.com/boitar/sair
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!date = 2026-11-06
#!tag = AI,Apple Intelligence,Router
#!type = normal

[Argument]
endpoint = input,"https://api.openai.com/v1/chat/completions",tag="Endpoint",desc="OpenAI 兼容的 /v1/chat/completions 接口地址"
api_key = input,"",tag="API Key",desc="上游 API Key（留空则不附带 Authorization 头）"
model = input,"gpt-4o-mini",tag="Model",desc="目标模型名称（如 gpt-4o-mini, deepseek-chat, gemini-2.5-flash）"
notify = select,"error","all","none",tag="Notifications",desc="通知策略：error 仅报错通知，all 全部通知，none 静默"
fallback = switch,true,tag="Official fallback",desc="上游失败或超时时自动放行回退到官方千问"
timeout_siri = input,7,tag="Siri timeout",desc="Siri 问答等待超时秒数（推荐 7）"
timeout_writing = input,15,tag="Writing timeout",desc="写作工具超时秒数（默认 15）"
timeout_vision = input,10,tag="Vision timeout",desc="视觉智能超时秒数（默认 10）"

[Script]
request if ${url} ~= /^https:\/\/prod-yabuli\.qianwen\.com\/sair\/(?:status|config|models|reset)(?:[/?].*)?$/i then script("https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js", {${endpoint}, ${api_key}, ${model}, ${notify}, ${fallback}, ${timeout_siri}, ${timeout_writing}, ${timeout_vision}}) with tag="SAIR Inspector Request", timeout=15, requires_body=false
response if ${url} ~= /^https:\/\/prod-yabuli\.qianwen\.com\/sair\/(?:status|config|models|reset)(?:[/?].*)?$/i then script("https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js", {${endpoint}, ${api_key}, ${model}, ${notify}, ${fallback}, ${timeout_siri}, ${timeout_writing}, ${timeout_vision}}) with tag="SAIR Inspector Response", timeout=15, requires_body=false
request if ${url} ~= /^https:\/\/prod-yabuli\.qianwen\.com\/.*/i then script("https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js", {${endpoint}, ${api_key}, ${model}, ${notify}, ${fallback}, ${timeout_siri}, ${timeout_writing}, ${timeout_vision}}) with tag="SAIR Request", timeout=60, requires_body=true
response if ${url} ~= /^https:\/\/prod-yabuli\.qianwen\.com\/.*/i then script("https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js", {${endpoint}, ${api_key}, ${model}, ${notify}, ${fallback}, ${timeout_siri}, ${timeout_writing}, ${timeout_vision}}) with tag="SAIR Response", timeout=60, requires_body=true

[Mitm]
hostname = %APPEND% prod-yabuli.qianwen.com

#!name = SAIR - Siri-ously AI Router
#!desc = 国行 Apple 智能大模型重写插件：通过 Loon 本地脚本重写将写作工具、Siri 问答与视觉智能转接至自定义大模型，支持原生参数调节与 Web 控制台。
#!author = boitar
#!homepage = https://github.com/boitar/sair
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!date = 2026-11-06
#!tag = AI,Apple Intelligence,Router
#!type = normal

[Argument]
endpoint = input,"https://api.openai.com/v1/chat/completions",tag="Endpoint",desc="OpenAI 兼容的 /v1/chat/completions 接口地址"
api_key = input,"",tag="API Key",desc="上游 API Key（留空则不附带 Authorization 头）"
model = input,"gpt-4o-mini",tag="Model",desc="目标模型名称（如 gpt-4o-mini、deepseek-chat、gemini-2.5-flash）"
notify = select,"error","all","none",tag="Notifications",desc="通知策略：error 仅报错通知、all 全部通知、none 静默"
fallback = switch,true,tag="Official fallback",desc="上游失败或超时时自动放行回退到官方千问"
timeout_siri = input,7,tag="Siri timeout",desc="Siri 问答等待超时秒数（推荐 7）"
timeout_writing = input,15,tag="Writing timeout",desc="写作工具超时秒数（默认 15）"
timeout_vision = input,10,tag="Vision timeout",desc="视觉智能超时秒数（默认 10）"
siri_prompt = input,"你是由 Apple 智能调用的专属伙伴。请直接、自然、口语化地回答用户指令，简明扼要，重点突出，切勿输出多余开场白或客套话。避免使用任何动作描写括号，以便语音自然播报。",tag="Siri Persona Prompt",desc="Siri 场景专属人格提示词（留空使用默认，亦可在 Web 控制台随时调整）"

[Host]
sair.box = 198.18.41.218
sair.hub = 198.18.41.219
sair.ai = 198.18.41.220

[Script]
request if ${url} ~= /^https?:\/\/(?:sair\.(?:box|hub|ai|local)|127\.0\.0\.1(?::\d+)?\/sair|localhost(?::\d+)?\/sair|prod-yabuli\.qianwen\.com\/sair)(?:[/?].*)?$/i then script("https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js", {${endpoint}, ${api_key}, ${model}, ${notify}, ${fallback}, ${timeout_siri}, ${timeout_writing}, ${timeout_vision}, ${siri_prompt}}) with tag="SAIR Inspector Request", timeout=15, requires_body=false
request if ${url} ~= /^https:\/\/prod-yabuli\.qianwen\.com\/.*/i then script("https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js", {${endpoint}, ${api_key}, ${model}, ${notify}, ${fallback}, ${timeout_siri}, ${timeout_writing}, ${timeout_vision}, ${siri_prompt}}) with tag="SAIR Request", timeout=60, requires_body=true
response if ${url} ~= /^https:\/\/prod-yabuli\.qianwen\.com\/.*/i then script("https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js", {${endpoint}, ${api_key}, ${model}, ${notify}, ${fallback}, ${timeout_siri}, ${timeout_writing}, ${timeout_vision}, ${siri_prompt}}) with tag="SAIR Response", timeout=60, requires_body=true

[Mitm]
hostname = %APPEND% prod-yabuli.qianwen.com, sair.box, sair.hub, sair.ai

#!name=SAIR - Siri-ously AI Router
#!desc=Route Apple Intelligence (iOS 27.3+) requests to your preferred LLM providers (OpenAI / Gemini / Claude / DeepSeek / Self-hosted) through Shadowrocket. Supports Writing Tools, Siri QA, and Visual Intelligence.
#!author=boitar
#!homepage=https://github.com/boitar/sair
#!category=AI / Automation
#!system=ios

[MITM]
hostname = %APPEND% prod-yabuli.qianwen.com

[Script]
# SAIR Dual-Hook Script for Shadowrocket
# Arguments can be edited in Module settings or configured dynamically via https://prod-yabuli.qianwen.com/sair/config:
# - endpoint: OpenAI-compatible /v1/chat/completions URL
# - api_key: Your API Key / Bearer token
# - model: Target model name (e.g. gpt-4o-mini, gemini-2.5-flash, deepseek-chat)
# - notify: "error" | "all" | "none"
# - fallback: "true" | "false"
# - timeout_siri: Siri QA timeout in seconds (default: 7)
# - timeout_writing: Writing Tools timeout in seconds (default: 15)
# - timeout_vision: Visual Intelligence timeout in seconds (default: 10)

SAIR Inspector Request = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/sair\/(status|config|models|reset)(?:[/?].*)?$,requires-body=false,timeout=15,script-path=https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js,argument="endpoint=https://api.openai.com/v1/chat/completions&api_key=&model=gpt-4o-mini&notify=error&fallback=true"

SAIR Inspector Response = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/sair\/(status|config|models|reset)(?:[/?].*)?$,requires-body=false,timeout=15,script-path=https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js,argument="endpoint=https://api.openai.com/v1/chat/completions&api_key=&model=gpt-4o-mini&notify=error&fallback=true"

SAIR Request = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/.*,requires-body=true,max-size=16777216,timeout=60,script-path=https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js,argument="endpoint=https://api.openai.com/v1/chat/completions&api_key=&model=gpt-4o-mini&notify=error&fallback=true"

SAIR Response = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/.*,requires-body=true,max-size=16777216,timeout=60,script-path=https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js,argument="endpoint=https://api.openai.com/v1/chat/completions&api_key=&model=gpt-4o-mini&notify=error&fallback=true"

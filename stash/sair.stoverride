name: SAIR - Siri-ously AI Router
desc: 国行 Apple 智能大模型重写覆写规则：通过 Stash 规则覆写与双阶段脚本，将写作工具、Siri 问答与视觉智能透明重写为自定义大模型。
author: boitar
homepage: https://github.com/boitar/sair

mitm:
  - "prod-yabuli.qianwen.com"

script:
  - name: SAIR Inspector Request
    match: ^https:\/\/prod-yabuli\.qianwen\.com\/sair\/(status|config|models|reset)(?:[/?].*)?$
    type: request
    require-body: false
    timeout: 15
    script-path: https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js
    argument: endpoint=https://api.openai.com/v1/chat/completions&api_key=&model=gpt-4o-mini&notify=error&fallback=true&timeout_siri=7&timeout_writing=15&timeout_vision=10

  - name: SAIR Inspector Response
    match: ^https:\/\/prod-yabuli\.qianwen\.com\/sair\/(status|config|models|reset)(?:[/?].*)?$
    type: response
    require-body: false
    timeout: 15
    script-path: https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js
    argument: endpoint=https://api.openai.com/v1/chat/completions&api_key=&model=gpt-4o-mini&notify=error&fallback=true&timeout_siri=7&timeout_writing=15&timeout_vision=10

  - name: SAIR Request
    match: ^https:\/\/prod-yabuli\.qianwen\.com\/.*
    type: request
    require-body: true
    max-size: 16777216
    timeout: 60
    script-path: https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js
    argument: endpoint=https://api.openai.com/v1/chat/completions&api_key=&model=gpt-4o-mini&notify=error&fallback=true&timeout_siri=7&timeout_writing=15&timeout_vision=10

  - name: SAIR Response
    match: ^https:\/\/prod-yabuli\.qianwen\.com\/.*
    type: response
    require-body: true
    max-size: 16777216
    timeout: 60
    script-path: https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js
    argument: endpoint=https://api.openai.com/v1/chat/completions&api_key=&model=gpt-4o-mini&notify=error&fallback=true&timeout_siri=7&timeout_writing=15&timeout_vision=10

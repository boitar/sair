name: SAIR - Siri-ously AI Router
desc: 国行 Apple 智能大模型重写覆写规则：通过 Stash 本地脚本重写，将写作工具、Siri 问答与视觉智能透明转接至自定义 OpenAI 兼容模型。安装后开启覆写，在 Safari 访问 http://sair.box 即可直达 Liquid Glass 控制台配置全部参数与人格设定。
author: boitar
homepage: https://github.com/boitar/sair

hosts:
  sair.box: 198.18.41.218
  sair.hub: 198.18.41.219
  sair.ai: 198.18.41.220

rules:
  - DOMAIN,sair.box,DIRECT
  - DOMAIN,sair.hub,DIRECT
  - DOMAIN,sair.ai,DIRECT
  - DOMAIN-SUFFIX,sair.box,DIRECT
  - DOMAIN-SUFFIX,sair.hub,DIRECT
  - DOMAIN-SUFFIX,sair.ai,DIRECT

http:
  force-http-engine:
    - "sair.box"
    - "*.sair.box"
    - "sair.hub"
    - "*.sair.hub"
    - "sair.ai"
    - "*.sair.ai"

mitm:
  - "prod-yabuli.qianwen.com"
  - "sair.box"
  - "*.sair.box"
  - "sair.hub"
  - "*.sair.hub"
  - "sair.ai"
  - "*.sair.ai"

script:
  - name: SAIR Dashboard
    match: ^https?:\/\/(sair\.(box|hub|ai|local)|127\.0\.0\.1(:[0-9]+)?\/sair|localhost(:[0-9]+)?\/sair|prod-yabuli\.qianwen\.com\/sair)(?:[/?].*)?$
    type: request
    require-body: false
    timeout: 15
    script-path: https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js

  - name: SAIR Request
    match: ^https:\/\/prod-yabuli\.qianwen\.com\/.*
    type: request
    require-body: true
    max-size: 16777216
    timeout: 60
    script-path: https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js

  - name: SAIR Response
    match: ^https:\/\/prod-yabuli\.qianwen\.com\/.*
    type: response
    require-body: true
    max-size: 16777216
    timeout: 60
    script-path: https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js

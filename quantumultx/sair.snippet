# SAIR - 国行 Apple 智能大模型重写片段 (Quantumult X)
# 通过 Quantumult X 本地脚本重写将写作工具、Siri 问答与视觉智能转接至自定义大模型。
# Author: boitar
# Homepage: https://github.com/boitar/sair
#
# 配置指南：
# 导入本 Snippet 并开启 MITM 后，可直接在 Safari 中打开如下页面通过 Web 控制台可视化配置参数：
# https://prod-yabuli.qianwen.com/sair/config

[rewrite_local]
# Inspector endpoints: status check, models probe, and dynamic configuration
^https:\/\/prod-yabuli\.qianwen\.com\/sair\/(status|config|models|reset)(?:[/?].*)?$ url script-request-header https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js
^https:\/\/prod-yabuli\.qianwen\.com\/sair\/(status|config|models|reset)(?:[/?].*)?$ url script-response-body https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js

# Apple Intelligence Dual-Hook Interception (Request Body Capture & Response SSE Rewrite)
^https:\/\/prod-yabuli\.qianwen\.com\/.* url script-request-body https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js
^https:\/\/prod-yabuli\.qianwen\.com\/.* url script-response-body https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js

[mitm]
hostname = prod-yabuli.qianwen.com

# SAIR - 国行 Apple 智能大模型重写片段 (Quantumult X)
# 通过 Quantumult X 本地脚本重写将写作工具、Siri 问答与视觉智能转接至自定义大模型。
# Author: boitar
# Homepage: https://github.com/boitar/sair
#
# 配置指南：
# 导入本 Snippet 并开启 MITM 后，可在 Safari 中直接访问 http://sair.box 打开 Liquid Glass 控制台配置参数与人格设定。

[rewrite_local]
# SAIR Web Dashboard & Inspector Route (http://sair.box or http://sair.hub or https://prod-yabuli.qianwen.com/sair)
^https?:\/\/(sair\.(box|hub|ai|local)|127\.0\.0\.1(:[0-9]+)?\/sair|localhost(:[0-9]+)?\/sair|prod-yabuli\.qianwen\.com\/sair)(?:[/?].*)?$ url script-request-header https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js

# Apple Intelligence Dual-Hook Interception (Request Body Capture & Response SSE Rewrite)
^https:\/\/prod-yabuli\.qianwen\.com\/.* url script-request-body https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js
^https:\/\/prod-yabuli\.qianwen\.com\/.* url script-response-body https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js

[filter_local]
host, sair.box, direct
host, sair.hub, direct
host, sair.ai, direct
host-suffix, sair.box, direct
host-suffix, sair.hub, direct
host-suffix, sair.ai, direct

[mitm]
hostname = prod-yabuli.qianwen.com, sair.box, *.sair.box, sair.hub, *.sair.hub, sair.ai, *.sair.ai

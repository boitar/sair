#!name=SAIR - Siri-ously AI Router
#!desc=国行 Apple 智能大模型重写模块：通过 Surge 本地脚本重写，将写作工具、Siri 问答与视觉智能透明转接至自定义 OpenAI 兼容模型（OpenAI / Claude / Gemini / DeepSeek 等）。
#!author=boitar
#!category=AI / Automation
#!system=ios
#!arguments=endpoint:https://api.openai.com/v1/chat/completions,api_key,model:gpt-4o-mini,notify:error,fallback:true,timeout_siri:7,timeout_writing:15,timeout_vision:10
#!arguments-desc=endpoint: 上游 OpenAI 兼容接口地址\napi_key: 上游 API Key（如 sk-...）\nmodel: 目标模型（如 gpt-4o-mini、deepseek-chat、gemini-2.5-flash）\nnotify: 通知策略（error/all/none）\nfallback: 出错或超时是否自动回退官方千问（true/false）\ntimeout_siri: Siri 场景超时秒数（推荐 7）\ntimeout_writing: 写作工具超时秒数（默认 15）\ntimeout_vision: 视觉智能超时秒数（默认 10）

[MITM]
hostname = %APPEND% prod-yabuli.qianwen.com

[Script]
# SAIR Dual-Hook Script
# Configure arguments below or pass via Surge Module arguments:
# - endpoint: OpenAI-compatible /v1/chat/completions URL
# - api_key: Your API Key / Bearer token
# - model: Target model name (e.g. gpt-4o-mini, gemini-2.5-flash, deepseek-chat)
# - notify: "error" (notify only on errors) or "all" (notify every interception) or "none"
# - fallback: "true" (fallback to official Qwen on error/timeout) or "false" (block on failure)
# - timeout_siri: Siri QA timeout in seconds (default: 7)
# - timeout_writing: Writing Tools timeout in seconds (default: 15)
# - timeout_vision: Visual Intelligence timeout in seconds (default: 10)

SAIR Inspector Request = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/sair\/(status|config|models|reset)(?:[/?].*)?$,requires-body=false,timeout=15,script-path=https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js,argument="endpoint={{{endpoint}}}&api_key={{{api_key}}}&model={{{model}}}&notify={{{notify}}}&fallback={{{fallback}}}&timeout_siri={{{timeout_siri}}}&timeout_writing={{{timeout_writing}}}&timeout_vision={{{timeout_vision}}}"

SAIR Inspector Response = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/sair\/(status|config|models|reset)(?:[/?].*)?$,requires-body=false,timeout=15,script-path=https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js,argument="endpoint={{{endpoint}}}&api_key={{{api_key}}}&model={{{model}}}&notify={{{notify}}}&fallback={{{fallback}}}&timeout_siri={{{timeout_siri}}}&timeout_writing={{{timeout_writing}}}&timeout_vision={{{timeout_vision}}}"

SAIR Request = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/.*,requires-body=true,max-size=16777216,timeout=60,script-path=https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js,argument="endpoint={{{endpoint}}}&api_key={{{api_key}}}&model={{{model}}}&notify={{{notify}}}&fallback={{{fallback}}}&timeout_siri={{{timeout_siri}}}&timeout_writing={{{timeout_writing}}}&timeout_vision={{{timeout_vision}}}"

SAIR Response = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/.*,requires-body=true,max-size=16777216,timeout=60,script-path=https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js,argument="endpoint={{{endpoint}}}&api_key={{{api_key}}}&model={{{model}}}&notify={{{notify}}}&fallback={{{fallback}}}&timeout_siri={{{timeout_siri}}}&timeout_writing={{{timeout_writing}}}&timeout_vision={{{timeout_vision}}}"

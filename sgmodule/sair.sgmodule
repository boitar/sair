#!name=SAIR - Siri-ously AI Router
#!desc=国行 Apple 智能大模型重写模块：通过 Surge 本地脚本重写，将写作工具、Siri 问答与视觉智能透明转接至自定义 OpenAI 兼容模型（OpenAI / Claude / Gemini / DeepSeek 等）。
#!author=boitar
#!category=AI / Automation
#!system=ios
#!arguments=endpoint:https://api.openai.com/v1/chat/completions,api_key:,model:gpt-4o-mini,notify:error,fallback:true,timeout_siri:7,timeout_writing:15,timeout_vision:10,siri_prompt:
#!arguments-desc=endpoint: 上游 OpenAI 兼容接口地址\napi_key: 上游 API Key（如 sk-...）\nmodel: 目标模型（如 gpt-4o-mini、deepseek-chat、gemini-2.5-flash）\nnotify: 通知策略（error/all/none）\nfallback: 出错或超时是否自动回退官方千问（true/false）\ntimeout_siri: Siri 场景超时秒数（推荐 7）\ntimeout_writing: 写作工具超时秒数（默认 15）\ntimeout_vision: 视觉智能超时秒数（默认 10）\nsiri_prompt: Siri 场景专属人格提示词（留空使用默认，亦可在 Web 控制台随时调整）

[MITM]
hostname = %APPEND% prod-yabuli.qianwen.com, sair.local, sair.hub

[Script]
# SAIR Web Dashboard & Inspector Route (supports http://sair.local or http://127.0.0.1/sair or https://prod-yabuli.qianwen.com/sair)
SAIR Dashboard = type=http-request,pattern=^https?:\/\/(sair\.(local|hub)|127\.0\.0\.1(:[0-9]+)?\/sair|localhost(:[0-9]+)?\/sair|prod-yabuli\.qianwen\.com\/sair)(?:[/?].*)?$,requires-body=false,timeout=15,script-path=https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js,argument="endpoint={{{endpoint}}}&api_key={{{api_key}}}&model={{{model}}}&notify={{{notify}}}&fallback={{{fallback}}}&timeout_siri={{{timeout_siri}}}&timeout_writing={{{timeout_writing}}}&timeout_vision={{{timeout_vision}}}&siri_prompt={{{siri_prompt}}}"

# Apple Intelligence Interception Hooks
SAIR Request = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/.*,requires-body=true,max-size=16777216,timeout=60,script-path=https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js,argument="endpoint={{{endpoint}}}&api_key={{{api_key}}}&model={{{model}}}&notify={{{notify}}}&fallback={{{fallback}}}&timeout_siri={{{timeout_siri}}}&timeout_writing={{{timeout_writing}}}&timeout_vision={{{timeout_vision}}}&siri_prompt={{{siri_prompt}}}"

SAIR Response = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/.*,requires-body=true,max-size=16777216,timeout=60,script-path=https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js,argument="endpoint={{{endpoint}}}&api_key={{{api_key}}}&model={{{model}}}&notify={{{notify}}}&fallback={{{fallback}}}&timeout_siri={{{timeout_siri}}}&timeout_writing={{{timeout_writing}}}&timeout_vision={{{timeout_vision}}}&siri_prompt={{{siri_prompt}}}"

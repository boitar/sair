#!name=SAIR - Siri-ously AI Router
#!desc=国行 Apple 智能大模型重写模块：通过 Surge 本地脚本重写，将写作工具、Siri 问答与视觉智能透明转接至自定义 OpenAI 兼容模型。安装后开启模块，在 Safari 访问 http://sair.box 即可直达 Liquid Glass 控制台配置全部参数与人格设定。
#!author=boitar
#!category=AI / Automation
#!system=ios

[General]
force-http-engine-hosts = %APPEND% sair.box, *.sair.box, sair.hub, *.sair.hub, sair.ai, *.sair.ai

[Host]
sair.box = 198.18.0.1
sair.hub = 198.18.0.1
sair.ai = 198.18.0.1

[MITM]
hostname = %APPEND% prod-yabuli.qianwen.com, sair.box, *.sair.box, sair.hub, *.sair.hub, sair.ai, *.sair.ai

[Script]
# SAIR Web Dashboard & Inspector Route (http://sair.box or http://sair.hub)
SAIR Dashboard = type=http-request,pattern=^https?:\/\/(sair\.(box|hub|ai|local)|127\.0\.0\.1(:[0-9]+)?\/sair|localhost(:[0-9]+)?\/sair|prod-yabuli\.qianwen\.com\/sair)(?:[/?].*)?$,requires-body=false,timeout=15,script-path=https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js

# Apple Intelligence Interception Hooks
SAIR Request = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/.*,requires-body=true,max-size=16777216,timeout=60,script-path=https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js

SAIR Response = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/.*,requires-body=true,max-size=16777216,timeout=60,script-path=https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js

#!name=SAIR - Siri-ously AI Router
#!desc=国行 Apple 智能大模型重写模块：通过 Surge 本地脚本重写，将写作工具、Siri 问答与视觉智能透明转接至自定义 OpenAI 兼容模型。安装后开启模块，在 Safari 访问 http://sair.local 即可配置全部参数。
#!author=boitar
#!category=AI / Automation
#!system=ios

[MITM]
hostname = %APPEND% prod-yabuli.qianwen.com, sair.local, sair.hub

[Script]
# SAIR Web Dashboard & Inspector Route (http://sair.local or http://127.0.0.1/sair)
SAIR Dashboard = type=http-request,pattern=^https?:\/\/(sair\.(local|hub)|127\.0\.0\.1(:[0-9]+)?\/sair|localhost(:[0-9]+)?\/sair|prod-yabuli\.qianwen\.com\/sair)(?:[/?].*)?$,requires-body=false,timeout=15,script-path=https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js

# Apple Intelligence Interception Hooks
SAIR Request = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/.*,requires-body=true,max-size=16777216,timeout=60,script-path=https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js

SAIR Response = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/.*,requires-body=true,max-size=16777216,timeout=60,script-path=https://raw.githubusercontent.com/boitar/sair/custom/scripts/sair_adapter.js

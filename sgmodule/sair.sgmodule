#!name=SAIR - Siri-ously AI Router
#!desc=Route Apple Intelligence (iOS 27.3+) requests to your preferred LLM providers (OpenAI / Gemini / Claude / DeepSeek / Self-hosted) through Surge. Supports Writing Tools, Siri QA, and Visual Intelligence.
#!author=boitar
#!category=AI / Automation
#!system=ios

[MITM]
hostname = %APPEND% prod-yabuli.qianwen.com

[Script]
# SAIR Dual-Hook Script
# Configure arguments below or pass via Surge Module arguments:
# - endpoint: OpenAI-compatible /v1/chat/completions URL
# - api_key: Your API Key / Bearer token
# - model: Target model name (e.g. gpt-4o-mini, gemini-2.5-flash, deepseek-chat)
# - notify: "error" (notify only on errors) or "all" (notify every interception) or "none"
# - fallback: "true" (fallback to official Qwen on error/timeout) or "false" (block on failure)
# - timeout_siri: Siri QA timeout in seconds (default: 7)
# - timeout_writing: Writing Tools timeout in seconds (default: 15)
# - timeout_vision: Visual Intelligence timeout in seconds (default: 10)

SAIR Inspector Request = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/sair\/(status|config|models)(?:[/?].*)?$,requires-body=false,timeout=15,script-path=https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js,argument="endpoint=https://api.openai.com/v1/chat/completions&api_key=YOUR_API_KEY&model=gpt-4o-mini&notify=error&fallback=true&timeout_siri=7&timeout_writing=15&timeout_vision=10"

SAIR Inspector Response = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/sair\/(status|config|models)(?:[/?].*)?$,requires-body=false,timeout=15,script-path=https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js,argument="endpoint=https://api.openai.com/v1/chat/completions&api_key=YOUR_API_KEY&model=gpt-4o-mini&notify=error&fallback=true&timeout_siri=7&timeout_writing=15&timeout_vision=10"

SAIR Request = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/.*,requires-body=true,max-size=16777216,timeout=60,script-path=https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js,argument="endpoint=https://api.openai.com/v1/chat/completions&api_key=YOUR_API_KEY&model=gpt-4o-mini&notify=error&fallback=true&timeout_siri=7&timeout_writing=15&timeout_vision=10"

SAIR Response = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/.*,requires-body=true,max-size=16777216,timeout=60,script-path=https://raw.githubusercontent.com/boitar/sair/main/scripts/sair_adapter.js,argument="endpoint=https://api.openai.com/v1/chat/completions&api_key=YOUR_API_KEY&model=gpt-4o-mini&notify=error&fallback=true&timeout_siri=7&timeout_writing=15&timeout_vision=10"
